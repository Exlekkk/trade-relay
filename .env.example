# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored on purpose.

# Binance USD-M futures API key. Use a dedicated READ-ONLY key:
# enable reading, disable withdrawals, and do not use this bot to place or cancel orders.
BINANCE_API_KEY=your_read_only_api_key
BINANCE_API_SECRET=your_read_only_api_secret

# Telegram bot token from @BotFather, and the target private group chat id.
# The bot must be a member of the group. Group chat ids are usually negative.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_group_chat_id

# Unused. Card updates publish immediately. An existing DEBOUNCE_SECONDS=20
# in a live .env can be left as-is; it does not delay Telegram updates.
# DEBOUNCE_SECONDS=0

# Optional. Default: ./data/state.json (gitignored). Stores Telegram message ids and last card status.
# STATE_FILE=./data/state.json

# Optional card fields. Defaults: SHOW_SIZE=false, SHOW_NOTIONAL=false.
# Quantity, notional, and unrealized PnL are hidden unless enabled.
# SHOW_SIZE=false
# SHOW_NOTIONAL=false

# Timezone used on the card timestamp. Default: Asia/Shanghai
# DISPLAY_TZ=Asia/Shanghai
